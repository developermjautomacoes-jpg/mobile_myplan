{
  "info": {
    "name": "myplan API",
    "description": "Testes das versões v1 e v2 e dos erros. Rodar na ordem das pastas. Os prazos usam as variáveis {{prazo}} e {{ontem}}, preenchidas no pre-request da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); d.setDate(d.getDate() + 5);",
          "pm.collectionVariables.set('prazo', d.toISOString().slice(0, 10));",
          "const o = new Date(); o.setDate(o.getDate() - 1);",
          "pm.collectionVariables.set('ontem', o.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Versões",
      "item": [
        {
          "name": "listar versões",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "versão inexistente (v3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v3/tarefas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v3",
                "tarefas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"erro no formato problem+json\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); pm.expect(pm.response.json()).to.have.property(\"codigo\"); pm.expect(pm.response.json()).to.have.property(\"dica\"); });",
                  "pm.test(\"código VERSAO_NAO_SUPORTADA\", () => pm.expect(pm.response.json().codigo).to.eql(\"VERSAO_NAO_SUPORTADA\"));"
                ]
              }
            }
          ]
        }
      ]
    },
