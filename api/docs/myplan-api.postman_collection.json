{
  "info": {
    "name": "myplan API",
    "description": "Rodar na ordem das pastas. O prazo usa a variável {{prazo}}, preenchida com uma data futura no pre-request da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); d.setDate(d.getDate() + 5);",
          "pm.collectionVariables.set('prazo', d.toISOString().slice(0, 10));",
          "const o = new Date(); o.setDate(o.getDate() - 1);",
          "pm.collectionVariables.set('ontem', o.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
